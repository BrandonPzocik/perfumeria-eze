# Base de datos SQLite local (se crea como server/data.db).
# En producción no se usa este archivo: ahí va Turso.
DATABASE_FILE="./data.db"

# Carpeta de fotos locales (backup). En producción las nuevas van a Cloudinary.
# UPLOAD_DIR="./uploads"

JWT_SECRET="cambia-esta-clave-en-produccion-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"
PORT=3001

# Credenciales del primer usuario admin (solo se usan la primera vez que se crea la base)
ADMIN_EMAIL="admin@maisonambar.com"
ADMIN_PASSWORD="admin1234"

# --- Producción (gratis). Localmente NO las pongas si querés seguir con SQLite + carpeta uploads. ---
# TURSO_DATABASE_URL="libsql://...."
# TURSO_AUTH_TOKEN="..."
# CLOUDINARY_CLOUD_NAME="..."
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."
# CLOUDINARY_FOLDER="perfumeria"
# CORS_ORIGIN="https://tu-sitio.vercel.app"
