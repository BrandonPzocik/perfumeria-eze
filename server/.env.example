# Base de datos SQLite local (no requiere Docker ni instalación).
# Por defecto se crea como server/data.db si no se define esta variable.
DATABASE_FILE="./data.db"

JWT_SECRET="cambia-esta-clave-en-produccion-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"
PORT=3001

# Credenciales del primer usuario admin (solo se usan la primera vez que se crea la base)
ADMIN_EMAIL="admin@maisonambar.com"
ADMIN_PASSWORD="admin1234"
